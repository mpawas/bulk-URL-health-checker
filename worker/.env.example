# Local worker (pnpm --filter ./worker dev). Docker Compose sets these itself.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/url_checker
REDIS_URL=redis://localhost:6379

# Queue / limiter / retry knobs live in src/modules/url-check/url-check.config.ts
# today. Uncomment and wire them when you need to retune without a code change:
# URL_CHECK_QUEUE=url-check
# URL_CHECK_RATE_LIMIT_MAX=10
# URL_CHECK_RATE_LIMIT_DURATION_MS=1000
# URL_CHECK_CONCURRENCY=5
# URL_CHECK_MAX_ATTEMPTS=3
# URL_CHECK_BACKOFF_DELAY_MS=1000
