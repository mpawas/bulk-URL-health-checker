# Local API (pnpm --filter ./api dev). Docker Compose sets these itself.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/url_checker
REDIS_URL=redis://localhost:6379
PORT=4000

# Used by `pnpm test:sse-ha` when not resolving the `api` hostname:
# API_URLS=http://127.0.0.1:4000,http://127.0.0.1:4001
# API_HOST=api
