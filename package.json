{
  "name": "bulk-url-checker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter ./api dev",
    "dev:worker": "pnpm --filter ./worker dev",
    "dev:web": "pnpm --filter ./web dev",
    "migrate": "pnpm --filter ./api migrate",
    "test:rate-limit": "pnpm --filter ./worker test:rate-limit",
    "test:sse-ha": "pnpm --filter ./api test:sse-ha",
    "build": "pnpm -r build",
    "typecheck": "tsc -b --clean && tsc -b"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.7.0"
}
